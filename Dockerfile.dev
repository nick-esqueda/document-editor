# Development image: installs dependencies inside the container so platform-specific
# binaries match Linux. docker-compose.yml mounts the source and picks the command.
FROM node:22-bookworm-slim

WORKDIR /app

COPY package.json package-lock.json ./
COPY shared/package.json shared/
COPY server/package.json server/
COPY client/package.json client/
RUN npm ci

COPY . .
