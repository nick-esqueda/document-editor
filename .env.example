# Copy to .env and adjust. Never commit .env.

# Postgres (used by docker compose to create the database)
POSTGRES_USER=doc_editor
POSTGRES_PASSWORD=doc_editor_dev
POSTGRES_DB=doc_editor

# Server
DATABASE_URL=postgres://doc_editor:doc_editor_dev@localhost:5432/doc_editor
TEST_DATABASE_URL=postgres://doc_editor:doc_editor_dev@localhost:5432/doc_editor_test
SESSION_SECRET=replace-with-a-long-random-string
PORT=3000

# Password given to the demo users (alice, bob, carol) by the seed script
SEED_PASSWORD=change-me-dev-password
