{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadAppSettings",
      "Effect": "Allow",
      "Action": "ssm:GetParametersByPath",
      "Resource": [
        "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/ajaia/prod",
        "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/ajaia/prod/*"
      ]
    },
    {
      "Sid": "ReadReleaseBundles",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::OPS_BUCKET/releases/*"
    },
    {
      "Sid": "WriteAndReadBackups",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::OPS_BUCKET/backups/*"
    },
    {
      "Sid": "ListBackups",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::OPS_BUCKET",
      "Condition": { "StringLike": { "s3:prefix": "backups/*" } }
    }
  ]
}
