# Caddy terminates HTTPS on the EC2 instance and forwards API calls to the api container.
# It gets and renews a Let's Encrypt certificate for ORIGIN_HOSTNAME by itself (port 80 must stay open).

{
	servers {
		# Only requests carrying CloudFront's secret header reach the API (see below), so the
		# X-Forwarded-For chain they bring is CloudFront's. Keeping it lets Express see the viewer's IP.
		trusted_proxies static 0.0.0.0/0 ::/0
	}
}

{$ORIGIN_HOSTNAME} {
	# CloudFront adds this header to every origin request. Anything without it
	# did not come through CloudFront, so it is refused.
	@fromCloudFront header X-Origin-Verify {$ORIGIN_VERIFY_SECRET}

	handle @fromCloudFront {
		reverse_proxy api:3000
	}

	handle {
		respond "Forbidden" 403
	}
}
